{
  "compilerOptions": {
    "target": "ES6",
    "lib": [
      "ES6",
      "ESNext"
    ],
    "module": "ESNext",
    "rootDir": "./",
    "moduleResolution": "node",
    "types": [
      "node"
    ],
    "allowJs": true,
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "~/*": [
        "src/*",
      ]
    }
  },
  "include": [
    "**/*.*",
  ],
  "exclude": [
    "./node_modules",
    "dist",
    "build",
    ".cache"
  ],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
  },
}